# Resultado de la compilacion: se regenera con compilar.bat
/build/
*.class

# Empaquetado
*.war

# Configuracion local con credenciales reales.
# Se versiona configuracion.properties.example, no el archivo en uso con
# credenciales de produccion.
src/main/resources/configuracion.local.properties

# Editores e IDE
.idea/
*.iml
nbproject/private/

# De la carpeta .vscode se versiona solo settings.json, que es configuracion
# del proyecto y no preferencias personales: sin el, la extension de Java
# marca como error cada import de javax.servlet.
.vscode/*
!.vscode/settings.json

# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Registros
*.log
