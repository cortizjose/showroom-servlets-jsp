<?xml version="1.0" encoding="UTF-8"?>

<!-- Descriptor de despliegue del modulo. -->

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Modulo Comercial del Showroom</display-name>
    <description>
        Modulo de gestion comercial: clientes, catalogo y cotizaciones.
        Desarrollado con Java Servlets y JSP sobre Apache Tomcat.
    </description>

    <!-- CONFIGURACION DE FORMATO. -->

    <!-- Locale de formato para las etiquetas <fmt:...> de JSTL. -->
    <context-param>
        <param-name>javax.servlet.jsp.jstl.fmt.locale</param-name>
        <param-value>es_CO</param-value>
    </context-param>

    <!-- FILTROS Se ejecutan antes de los servlets. -->

    <filter>
        <filter-name>FiltroCodificacion</filter-name>
        <filter-class>co.edu.sena.showroom.filtros.FiltroCodificacion</filter-class>
        <init-param>
            <param-name>codificacion</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>FiltroCodificacion</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>FiltroAutenticacion</filter-name>
        <filter-class>co.edu.sena.showroom.filtros.FiltroAutenticacion</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>FiltroAutenticacion</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>co.edu.sena.showroom.servlets.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CerrarSesionServlet</servlet-name>
        <servlet-class>co.edu.sena.showroom.servlets.CerrarSesionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CerrarSesionServlet</servlet-name>
        <url-pattern>/cerrar-sesion</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TableroServlet</servlet-name>
        <servlet-class>co.edu.sena.showroom.servlets.TableroServlet</servlet-class>
        <!-- load-on-startup positivo: Tomcat crea el servlet al arrancar la aplicacion y no al recibir la primera peticion. -->
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>TableroServlet</servlet-name>
        <url-pattern>/tablero</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ClienteServlet</servlet-name>
        <servlet-class>co.edu.sena.showroom.servlets.ClienteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ClienteServlet</servlet-name>
        <url-pattern>/clientes</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProductoServlet</servlet-name>
        <servlet-class>co.edu.sena.showroom.servlets.ProductoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductoServlet</servlet-name>
        <url-pattern>/productos</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CotizacionServlet</servlet-name>
        <servlet-class>co.edu.sena.showroom.servlets.CotizacionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CotizacionServlet</servlet-name>
        <url-pattern>/cotizaciones</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <!-- HttpOnly impide que JavaScript lea la cookie de sesion, lo que limita el dano de un ataque XSS. -->
            <http-only>true</http-only>
        </cookie-config>
        <!-- Solo cookies: asi el identificador de sesion nunca aparece en la URL, donde quedaria en el historial y en los registros. -->
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- PAGINA DE INICIO Y PAGINAS DE ERROR. -->

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/vistas/error/403.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/vistas/error/404.jsp</location>
    </error-page>
    <error-page>
        <!-- Pagina propia para los errores no previstos: el usuario no ve la traza de la excepcion. -->
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/vistas/error/500.jsp</location>
    </error-page>

</web-app>
